# Cloudflare Workers Static Assets honors a `_headers` file the same way Pages
# does. Each match overrides the default response headers for matching paths.
#
# HARD LIMIT: Cloudflare rejects the deploy above 100 rules (the whole build
# fails), so keep this file lean. Anything loaded with ?v=DEPLOY_HASH needs NO
# rule for correctness (a deploy changes its URL); immutable rules here are a
# pure optimization for the heaviest repeat-loaded files. Never add a rule per
# brand by hand — the generated block at the bottom is 2 rules per brand and
# stamp-deploy warns when the total nears the cap.
#
# Strategy: HTML must revalidate on every request so deploys roll out
# instantly; byte-stable assets cache for a year.

# Long-cache the static byte-stable assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Version-busted (?v=DEPLOY_HASH) app files: immutable per deploy. Only the
# production .js names get rules — the .jsx sources matter only in local dev.
/colors_and_type.css
  Cache-Control: public, max-age=31536000, immutable
/portal/PortalApp.js
  Cache-Control: public, max-age=31536000, immutable
/blueprint-template/BlueprintTemplate.js
  Cache-Control: public, max-age=31536000, immutable
/estimate-template/EstimateTemplate.js
  Cache-Control: public, max-age=31536000, immutable
/discovery/scenes/*
  Cache-Control: public, max-age=31536000, immutable
/discovery/discovery-data.js
  Cache-Control: public, max-age=31536000, immutable
/discovery/DiscoveryExperience.js
  Cache-Control: public, max-age=31536000, immutable
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable

# HTML + admin/legal pages must revalidate so a deploy always wins.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/discovery/index.html
  Cache-Control: public, max-age=0, must-revalidate
/blueprint-template/index.html
  Cache-Control: public, max-age=0, must-revalidate
/estimate-template/index.html
  Cache-Control: public, max-age=0, must-revalidate
/legal/*
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

