# Cloudflare Workers Static Assets honors a `_headers` file the same way Pages
# does. Each match overrides the default response headers for matching paths.
#
# Strategy: HTML must revalidate on every request so deploys roll out instantly;
# byte-stable assets (fonts, images, vendored JS, version-busted CSS) cache for a
# year. The per-brand rules below the marker are GENERATED at deploy by
# scripts/stamp-deploy.js (it scans public/ for blueprint dirs), so adding a new
# blueprint needs no hand-editing here — that manual list was the source of a
# stale-after-deploy bug.

# Long-cache the static byte-stable assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS is version-busted from the HTML (?v=DEPLOY_HASH), so treat as immutable.
/colors_and_type.css
  Cache-Control: public, max-age=31536000, immutable

# Root-page JSX/JS components change with deploys; revalidate.
/components/*
  Cache-Control: public, max-age=300, s-maxage=86400

# Shared scripts + admin/legal pages must revalidate so a deploy always wins.
/legal/*
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# Root + section HTML always revalidates.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

