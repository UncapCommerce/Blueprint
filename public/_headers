# Cloudflare Workers Static Assets honors a `_headers` file the same way Pages
# does. Each match overrides the default response headers for matching paths.
#
# Strategy: HTML must revalidate on every request so deploys roll out instantly;
# byte-stable assets (fonts, images, vendored JS, version-busted CSS) cache for a
# year. The per-brand rules below the marker are GENERATED at deploy by
# scripts/stamp-deploy.js (it scans public/ for blueprint dirs), so adding a new
# blueprint needs no hand-editing here — that manual list was the source of a
# stale-after-deploy bug.

# Long-cache the static byte-stable assets.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS is version-busted from the HTML (?v=DEPLOY_HASH), so treat as immutable.
/colors_and_type.css
  Cache-Control: public, max-age=31536000, immutable

# Version-busted app scripts (?v=DEPLOY_HASH in every referencing page) are
# byte-stable per deploy, so cache them like the CSS above. Each rule names
# both the .jsx source (dev) and the precompiled .js sibling (production).
# These come AFTER the broader /admin/* and /legal/* revalidate rules below
# would match, but _headers gives later, more specific rules precedence, so
# order them after those blocks anyway (see the overrides section).
/portal/PortalApp.jsx
  Cache-Control: public, max-age=31536000, immutable
/portal/PortalApp.js
  Cache-Control: public, max-age=31536000, immutable
/blueprint-template/BlueprintTemplate.jsx
  Cache-Control: public, max-age=31536000, immutable
/blueprint-template/BlueprintTemplate.js
  Cache-Control: public, max-age=31536000, immutable
/blueprint-template/index.html
  Cache-Control: public, max-age=0, must-revalidate
/estimate-template/EstimateTemplate.jsx
  Cache-Control: public, max-age=31536000, immutable
/estimate-template/EstimateTemplate.js
  Cache-Control: public, max-age=31536000, immutable
/estimate-template/index.html
  Cache-Control: public, max-age=0, must-revalidate
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable

# Discovery scripts are version-busted from index.html (?v=DEPLOY_HASH), so
# each deploy's bytes are immutable; the HTML itself must revalidate. Covers
# both the .jsx source (dev) and the precompiled .js sibling (production).
/discovery/scenes/*
  Cache-Control: public, max-age=31536000, immutable
/discovery/discovery-data.js
  Cache-Control: public, max-age=31536000, immutable
/discovery/DiscoveryExperience.jsx
  Cache-Control: public, max-age=31536000, immutable
/discovery/DiscoveryExperience.js
  Cache-Control: public, max-age=31536000, immutable
/discovery/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Shared scripts + admin/legal pages must revalidate so a deploy always wins.
/legal/*
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# …except their version-busted scripts, which are byte-stable per deploy.
# (Later rules win over the broader matches above.)
/legal/UncapMSA.jsx
  Cache-Control: public, max-age=31536000, immutable
/legal/UncapMSA.js
  Cache-Control: public, max-age=31536000, immutable
/admin/AdminApp.jsx
  Cache-Control: public, max-age=31536000, immutable
/admin/AdminApp.js
  Cache-Control: public, max-age=31536000, immutable
/admin/AdminToolbar.jsx
  Cache-Control: public, max-age=31536000, immutable
/admin/AdminToolbar.js
  Cache-Control: public, max-age=31536000, immutable

# Root + section HTML always revalidates.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

